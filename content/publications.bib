@inproceedings{fan2026uncertainty,
  selected = {true},
  order = {1},
  title = {Uncertainty-aware Generative Recommendation},
  author = {Chenxiao Fan and Chongming Gao and Yaxin Gong and Haoyan Liu and Fuli Feng and Xiangnan He},
  year = {2026},
  month = aug,
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining},
  venue = {KDD},
  pages = {1015--1026},
  doi = {10.1145/3770855.3817975},
  url = {https://arxiv.org/abs/2602.11719},
  arxiv = {2602.11719},
  code = {https://github.com/cxfann/UGR},
  description = {Addresses uncertainty blindness in generative recommendation through uncertainty-weighted rewards, difficulty-aware optimization, and explicit confidence alignment.},
  keywords = {Generative Recommendation, Uncertainty, Reinforcement Learning},
  abstract = {Generative Recommendation has emerged as a transformative paradigm, reformulating recommendation as an end-to-end autoregressive sequence generation task. Despite its promise, existing preference optimization methods typically rely on binary outcome correctness, suffering from a systemic limitation we term uncertainty blindness. This issue manifests in the neglect of the model's intrinsic generation confidence, the variation in sample learning difficulty, and the lack of explicit confidence expression, directly leading to unstable training dynamics and unquantifiable decision risks. We propose Uncertainty-aware Generative Recommendation (UGR), a unified framework that leverages uncertainty as a critical signal for adaptive optimization. UGR combines an uncertainty-weighted reward, difficulty-aware optimization dynamics, and explicit confidence alignment. Extensive experiments demonstrate superior recommendation performance, more stable training, and reliable downstream risk-aware applications.}
}

@inproceedings{fan2025flame,
  selected = {true},
  order = {2},
  title = {Fine-grained List-wise Alignment for Generative Medication Recommendation},
  author = {Chenxiao Fan and Chongming Gao and Wentao Shi and Yaxin Gong and Zihao Zhao and Fuli Feng},
  year = {2025},
  month = nov,
  booktitle = {Advances in Neural Information Processing Systems 38},
  venue = {NeurIPS},
  pages = {53569--53593},
  doi = {10.52202/085713-1602},
  url = {https://arxiv.org/abs/2505.20218},
  arxiv = {2505.20218},
  code = {https://github.com/cxfann/Flame},
  award = {Spotlight},
  description = {Formulates medication recommendation as list-wise generation and uses step-wise GRPO to improve accuracy while controlling drug--drug interaction risk.},
  keywords = {Medication Recommendation, List-wise Alignment, Reinforcement Learning},
  abstract = {Accurate and safe medication recommendations are critical for effective clinical decision-making, especially in multimorbidity cases. Existing systems rely on point-wise prediction paradigms that overlook synergistic drug effects and potential adverse drug--drug interactions. We propose FLAME, a fine-grained list-wise alignment framework for large language models that enables drug-by-drug generation of medication lists. FLAME formulates recommendation as a sequential decision process and devises step-wise Group Relative Policy Optimization with potential-based reward shaping. Experiments demonstrate state-of-the-art accuracy, controllable safety--accuracy trade-offs, and strong generalization across diverse clinical scenarios.}
}

@inproceedings{gao2025flower,
  selected = {true},
  order = {3},
  title = {Process-Supervised LLM Recommenders via Flow-guided Tuning},
  author = {Chongming Gao# and Mengyao Gao# and Chenxiao Fan and Shuai Yuan and Wentao Shi and Xiangnan He},
  year = {2025},
  month = jul,
  booktitle = {Proceedings of the 48th International ACM SIGIR Conference on Research and Development in Information Retrieval},
  venue = {SIGIR},
  pages = {1934--1943},
  doi = {10.1145/3726302.3729981},
  url = {https://arxiv.org/abs/2503.07377},
  arxiv = {2503.07377},
  code = {https://github.com/Mr-Peach0301/Flower},
  description = {Uses GFlowNet-based process supervision to align token-level generation with item-level rewards, improving accuracy, diversity, and fairness.},
  keywords = {Generative Recommendation, GFlowNet, Process Supervision},
  abstract = {While large language models are increasingly adapted for recommendation systems via supervised fine-tuning, this approach amplifies popularity bias due to its likelihood maximization objective, compromising recommendation diversity and fairness. We present Flower, which replaces standard supervised fine-tuning with a Generative Flow Network framework that enacts process supervision through token-level reward propagation. Flower decomposes item-level rewards into token rewards, enabling direct alignment between token generation probabilities and their reward signals. Experiments demonstrate superior distribution fitting and improvements in accuracy, fairness, and diversity.}
}

@article{ren2026medical,
  selected = {true},
  order = {4},
  title = {Medical Reasoning With Large Language Models: A Systematic Review and Evaluation},
  author = {Xiaohan Ren and Chenxiao Fan and Wenyin Ma and Hongliang He and Chongming Gao and Xiaoyan Zhao and Fuli Feng},
  year = {2026},
  month = may,
  journal = {iNew Medicine},
  venue = {iNew Medicine},
  volume = {2},
  number = {3},
  pages = {e70056},
  doi = {10.1002/inm3.70056},
  url = {https://arxiv.org/abs/2604.08559},
  arxiv = {2604.08559},
  code = {https://github.com/RXH04-USTC/Medical-Reasoning-Survey},
  description = {Systematizes LLM-based medical reasoning, evaluates representative models under a unified setting, and introduces MR-Bench using real-world clinical data.},
  keywords = {Medical Reasoning, Large Language Models, Benchmark},
  abstract = {Large language models have achieved strong performance on medical exam-style tasks, motivating growing interest in their deployment in real-world clinical settings. We present a comprehensive review of medical reasoning with LLMs grounded in cognitive theories of clinical reasoning, organizing existing methods into seven major technical routes spanning training-based and training-free approaches. We further conduct a unified cross-benchmark evaluation of representative medical reasoning models and introduce MR-Bench, a benchmark derived from real-world hospital data. Evaluations expose a pronounced gap between exam-level performance and accuracy on authentic clinical decision tasks.}
}

@misc{fan2026credo,
  selected = {true},
  order = {5},
  title = {Beyond Verbalized Confidence: Calibrating Reasoners with Differentiable Readouts},
  author = {Chenxiao Fan and Chongming Gao and Gangyi Zhang and Leyang Shen and Yaxin Gong and Jiamin Wang and Jiakai Wang and Dong Wang and Yang Liu and Fuli Feng and Xiangnan He},
  year = {2026},
  month = sep,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2609.34857},
  arxiv = {2609.34857},
  description = {Introduces CREDO, a differentiable confidence readout for RLVR that jointly improves reasoning accuracy, calibration, abstention, and selective prediction.},
  keywords = {LLM Reasoning, Calibration, Reinforcement Learning},
  abstract = {Reinforcement learning with verifiable rewards trains reasoning models to produce correct answers, but does not ensure that their stated confidence is calibrated. We propose CREDO (Confidence REaDOut), which replaces sampled verbalized confidence with a deterministic readout from a dedicated token pair in the model's output distribution and trains it by differentiable regression. CREDO further uses confidence--outcome disagreement to weight rollouts so that accuracy and calibration improve together. Across mathematical and code reasoning, CREDO attains the best accuracy and calibration, with gains extending to abstention and selective prediction.}
}

@misc{wang2026trustworthy,
  selected = {true},
  order = {6},
  title = {Trustworthy Recommendation in the Era of Large Language Models: Opportunities and Challenges},
  author = {Bohao Wang and Yu Cui and Zhenxiang Xu and Jujia Zhao and Chenxiao Fan and Jizhi Zhang and Weiqin Yang and Shengjia Zhang and Sirui Chen and Yang Zhang and Xiaoyan Zhao and Wenjie Wang and Chongming Gao and Fuli Feng and Xiangnan He and Jiawei Chen},
  year = {2026},
  month = may,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2606.00540},
  arxiv = {2606.00540},
  description = {Reviews over 200 studies and maps 13 opportunities and 18 challenges for trustworthy LLM-empowered recommendation across six dimensions.},
  keywords = {Trustworthy Recommendation, Large Language Models, Survey},
  abstract = {The field of recommender systems is undergoing shifts toward comprehensive trustworthiness and extensive integration of large language models. We present a systematic review of trustworthy LLM-empowered recommendation. By analyzing over 200 recent studies, we show that LLMs act as a double-edged sword: their capabilities create opportunities to enhance trustworthiness while introducing new risks. We identify 13 opportunities and 18 challenges across six dimensions of trustworthiness, review commonly used datasets and evaluation metrics, and outline critical open problems and future directions.}
}

@misc{zhao2025lamo,
  selected = {true},
  order = {7},
  title = {Fine-grained Alignment of Large Language Models for General Medication Recommendation without Overprescription},
  author = {Zihao Zhao# and Chenxiao Fan# and Junlong Liu and Zheng Wang and Xiangnan He and Chongming Gao and Juan Li and Fuli Feng},
  year = {2025},
  month = mar,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2503.03687},
  arxiv = {2503.03687},
  code = {https://github.com/zzhUSTC2016/LAMO},
  description = {Adapts LLMs to medication recommendation with medication-aware training, reducing overprescription and improving temporal and cross-dataset generalization.},
  keywords = {Medication Recommendation, Large Language Models, Clinical Decision Support},
  abstract = {Large language models hold significant promise for general medication recommendation because of their ability to interpret clinical notes and flexibly encode medications. We evaluate general-purpose and medical-specific LLMs, revealing unsatisfactory precision and severe overprescription. We introduce Language-Assisted Medication Recommendation, which tailors LLMs for medication recommendation in a medication-aware manner and improves the use of clinical notes. Fine-tuned models outperform existing methods in internal validation, generalize across temporal and external validations, and maintain high accuracy for out-of-distribution medications.}
}

@misc{gong2026upstream,
  order = {8},
  title = {When Upstream Messages Override Correct Answers: A Controlled Study of Multi-Agent LLM Collaboration},
  author = {Yaxin Gong and Gangyi Zhang and Chongming Gao and Leyang Shen and Chenxiao Fan and Jiakai Wang and Dong Wang and Yang Liu and Wenjie Wang and Xiangnan He},
  year = {2026},
  month = sep,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2609.36855},
  arxiv = {2609.36855},
  description = {Isolates the benefits and risks of inter-agent messaging, showing how incorrect upstream messages can overwrite evidence-supported answers through answer substitution.},
  keywords = {Multi-Agent Systems, Large Language Models, Reliability},
  abstract = {Multi-agent LLM systems rely on message passing among specialized agents, but an incorrect upstream answer may cause a downstream agent to override a correct answer supported by its own evidence. We study this problem with controlled experiments across five benchmarks and five receivers while keeping the downstream task and evidence fixed. Messages often help when the receiver would otherwise answer incorrectly, but an incorrect upstream message changes an otherwise correct answer in up to 32 percent of cases. In 94 percent of audited harmful cases, the receiver copies the upstream's specific wrong answer, a pattern we term answer substitution.}
}

@misc{chen2026padrec,
  order = {9},
  title = {Position-Aware Drafting for Inference Acceleration in LLM-Based Generative List-Wise Recommendation},
  author = {Jiaju Chen and Chongming Gao and Chenxiao Fan and Haoyan Liu and Qingpeng Cai and Peng Jiang and Xiangnan He},
  year = {2026},
  month = apr,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2604.27747},
  arxiv = {2604.27747},
  code = {https://github.com/Jiaju-Chen/PAD-Rec},
  description = {Accelerates generative list-wise recommendation with item- and draft-step-aware position embeddings while largely preserving recommendation quality.},
  keywords = {Generative Recommendation, Speculative Decoding, Inference Acceleration},
  abstract = {Large language model-based generative list-wise recommendation has advanced rapidly, but sequential decoding remains latency-prone. We introduce PAD-Rec, a lightweight position-aware drafting module that augments the draft model with item position embeddings and step position embeddings. These signals model within-item token structure and depth-dependent uncertainty with negligible inference overhead. Experiments on four real-world datasets show up to 3.1 times wall-clock speedup and about 5 percent average speedup gain over strong speculative decoding baselines while largely preserving recommendation quality.}
}

@misc{gong2026trirec,
  order = {10},
  title = {Breaking User-Centric Agency: A Tri-Party Framework for Agent-Based Recommendation},
  author = {Yaxin Gong and Chongming Gao and Chenxiao Fan and Haoyan Liu and Wenjie Wang and Jianshan Sun and Yangyang Li and Fuli Feng and Xiangnan He},
  year = {2026},
  month = mar,
  journal = {arXiv preprint},
  venue = {arXiv},
  url = {https://arxiv.org/abs/2603.10673},
  arxiv = {2603.10673},
  code = {https://github.com/Marfekey/TriRec},
  description = {Introduces user, item, and platform agents to jointly optimize relevance, item utility, and exposure fairness.},
  keywords = {Agent-Based Recommendation, Multi-Agent Systems, Exposure Fairness},
  abstract = {Large language models have spurred interest in agent-based recommender systems, yet most approaches remain user-centric and leave items as passive entities. We propose TriRec, a tri-party LLM-agent recommendation framework. Item agents generate target-user-conditioned self-promotion to lower cold-start barriers, while a platform agent performs sequential re-ranking to balance relevance, item utility, and exposure fairness. Experiments on four public datasets improve accuracy, fairness, and item-level utility, while catalogue-verifiable constraints sharply reduce promotional exaggeration.}
}
